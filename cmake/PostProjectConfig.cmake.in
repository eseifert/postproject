@PACKAGE_INIT@

set_and_check(
    PostProject_LIBRARY
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/@POSTPROJECT_LIBRARY_FILENAME@"
)

if(NOT TARGET PostProject::postproject)
    if(WIN32)
        add_library(PostProject::postproject SHARED IMPORTED)
        set_and_check(
            PostProject_RUNTIME_LIBRARY
            "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/@POSTPROJECT_RUNTIME_LIBRARY_FILENAME@"
        )
        set_target_properties(
            PostProject::postproject
            PROPERTIES
                IMPORTED_IMPLIB "${PostProject_LIBRARY}"
                IMPORTED_LOCATION "${PostProject_RUNTIME_LIBRARY}"
        )
    else()
        add_library(PostProject::postproject UNKNOWN IMPORTED)
        set_target_properties(
            PostProject::postproject
            PROPERTIES IMPORTED_LOCATION "${PostProject_LIBRARY}"
        )
    endif()
    set_target_properties(
        PostProject::postproject
        PROPERTIES
            INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
            INTERFACE_COMPILE_DEFINITIONS POSTPROJECT_SHARED
    )
endif()

check_required_components(PostProject)
